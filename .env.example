# Skopiuj do .env.local i uzupełnij (osobne wartości dla staging i production w Vercel).
# Nigdy nie commituj prawdziwych wartości.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tylko serwer (zaproszenia, blokada kont). Nigdy z prefiksem NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# E-maile Auth (zaproszenia, reset hasła). Puste/false = tylko linki tworzone w sekcji Zespół.
# Ustaw true dopiero po skonfigurowaniu SMTP Resend (docs/WDROZENIE-STAGING.md, sekcja 6).
AUTH_EMAILS_ENABLED=

# Sekret HMAC do limitu nieudanych logowań (skróty loginu i IP w login_attempts). Losowy, min. 32 znaki.
LOGIN_RATE_SECRET=
